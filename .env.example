# Discord Bot Token (REQUIRED)
DISCORD_TOKEN_BOT=

# Command prefix (default: !)
PREFIX=!

# Role ID required to use bot commands (REQUIRED)
ROLE_TO_SEND_MESSAGE=

# Text channel ID where commands can be used (REQUIRED)
CHANNEL_TO_SEND_MESSAGE=

# Voice channel ID for audio playback (REQUIRED)
CHANNEL_AUDIO_TORRE=

# Path to the .pls playlist file (REQUIRED)
PLS_FILE=bot/audio/LIVE_ATC_PLS_EXAMPLE.pls

# Max retries for reconnection attempts (default: 5)
MAX_RETRIES=5

# Base delay in seconds between retries, doubles each attempt (default: 10)
RETRY_DELAY_SECONDS=10

# Embed customization (optional)
EMBED_AUTHOR_NAME=ATC Bot
EMBED_THUMBNAIL_URL=
EMBED_AUTHOR_ICON_URL=
EMBED_FOOTER_TEXT=ATC Bot
EMBED_FOOTER_ICON_URL=
